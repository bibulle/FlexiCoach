{
  "name": "backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "backend"
  ],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/backend-e2e"
      ],
      "dependsOn": [
        "backend:build",
        "backend:serve"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "e2e-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/backend-e2e/jest.config.ts --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
