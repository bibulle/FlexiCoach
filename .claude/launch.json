{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "npx nx serve frontend --port $PORT"],
      "port": 4200,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "npx nx build backend --configuration=development && node dist/apps/backend/main.js"],
      "port": 3000
    }
  ]
}
